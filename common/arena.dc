// Distributed classes of Panda Arena.
//
// Every participant (ServerRepository, AI repository, C++ client and Python
// bots) loads direct.dc first and this file second. Class/field numbers and
// the DC hash depend on that order and on the exact content, and the server
// refuses clients whose hash differs, so never edit one copy only.
//
// The AI repository creates and owns every object here, players included:
// a player's client asks to join (requestJoin) and then only sends what its
// player wants to do. Who may send what (enforced by the server, see
// server/arena/policy.py):
//   * a player may send the p2p fields of AI-owned objects (requests),
//   * everything else is sent by the AI repository only.

keyword broadcast;
keyword ram;
keyword p2p;

from arena.DistributedArenaPlayer/AI import DistributedArenaPlayer/AI
from arena.DistributedArenaGame/AI import DistributedArenaGame/AI

struct ArenaPillar {
  int16 / 10 x;
  int16 / 10 y;
  uint16 / 100 radius;
};

struct ArenaOrb {
  uint16 orbId;
  int16 / 10 x;
  int16 / 10 y;
  uint8(0-1) kind;              // 0 = normal, 1 = gold
};

struct ArenaScore {
  uint8 slot;                   // the player's slot (see below)
  uint16 score;
};

// One per connected player, created by the AI in the arena zone when the
// player's client asks to join (requestJoin), with the name and color the AI
// accepted. Movement is not a field: inputs and positions travel as compact
// binary messages (CLIENT_INPUT / SERVER_FRAME in server/arena/protocol.py).
// The AI gives every player a one-byte slot, and every field below names
// players by slot.
dclass DistributedArenaPlayer : DistributedObject {
  setName(string(1-16) name) required broadcast ram;
  setColorIndex(uint8(0-11) index) required broadcast ram;
};

// One per server, created by the AI in the arena zone. Owns the game state.
dclass DistributedArenaGame : DistributedObject {
  // Tuning, decided by the server so clients and server always agree.
  setRules(uint16 / 100 maxSpeed, uint16 / 100 accel, uint16 / 100 dashSpeed,
           uint16 / 1000 dashTime, uint16 / 100 dashCooldown,
           uint16 / 100 playerRadius, uint16 / 100 orbRadius) required broadcast ram;
  setArena(uint16 / 10 radius, ArenaPillar pillars[]) required broadcast ram;
  // state: 0 = playing, 1 = intermission. endTime: 32-bit network time.
  setRound(uint8(0-1) state, uint16 roundNumber, int32 endTime) required broadcast ram;
  setOrbs(ArenaOrb orbs[]) required broadcast ram;
  setScores(ArenaScore scores[]) required broadcast ram;

  // Events, AI -> everybody in the zone. The frequent ones (an orb spawned
  // or collected, a dash hit) travel in SERVER_FRAME with the movement
  // (server/arena/frame.py), a few bytes each and in the same packet.
  chatMessage(uint8 slot, string(1-120) text) broadcast;
  // Game messages as codes (protocol.py NOTICE_*); clients write the text.
  notice(uint8 kind, uint8 slot, uint16 value) broadcast;

  // Requests, client -> AI (p2p = delivered to the owner of the object only).
  requestJoin(string(1-16) name, uint8(0-11) colorIndex) p2p;
  requestChat(string(1-120) text) p2p;
  ping(uint16 context) p2p;

  // Replies, AI -> one client (sent as targeted updates).
  joined(uint8 slot, uint32 playerId);   // your player: its slot and doId
  pong(uint16 context);
};
